
library(Rfast)
library(Directional)
library(vMVS)

n <- 1000  ;  p <- 50
x <- cbind(1, matrnorm(n, p) )
id <- sample(2:(p + 1), 5)
be <- matrix(0, nrow = p + 1, ncol = 2)
be[1, ] <- c(-1, 1)
be[id, 1:2] <- rnorm(10)
mu <- x %*% be
ki <- sqrt( rowsums(mu^2) )
mu <- mu / ki
y <- numeric(n)
for ( i in 1:1000 )  y[i] <- rgcpc(1, mu[i, ], g = ki[i], rho = 0.1)
y <- cbind( cos(y), sin(y) )
a <- vMVS::vm.gomp(y, x)
