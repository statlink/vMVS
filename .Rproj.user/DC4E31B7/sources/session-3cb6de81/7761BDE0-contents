library(omphc)
m <- rbn2(50000, p = 50, nei = 3)
G <- m$G
x <- m$x
R = NULL
method = "pvalue"
tol = 0.1

dm <- dim(x)
n <- dm[1]   ;   d <- dm[2]
nama <- colnames(x)
if ( is.null( nama ) )  nama <- paste("X", 1:d, sep = "")
G <- matrix(0, d, d)
colnames(G) <- rownames(G) <- nama
Rho <- sapply(nama, function(x) NULL)

x <- Rfast::standardise(x)
if ( is.null(R) ) {
  xx <- crossprod(x)
  R <- xx / (n - 1)
} else  xx <- R * (n - 1)
diag(R) <- 0
ini.sel <- Rfast::colMaxs( abs(R) )

logalpha <- log(tol)

forward_loop_R <- function(x, R, xx, ini.sel, nama, n, d, G, Rho, logalpha) {
  
  for (j in 1:d) {
    rho <- 0
    ind <- 1:d
    y <- x[, j]
    ind[j] <- 0
    sel <- ini.sel[j]
    sela <- sel
    res <- y - x[, sela] * R[sela, j]
    sse2 <- sum(res^2)
    
    stat <- (n - 1 - sse2) / sse2 *
      (n - length(sela) - 1)
    
    rho[2] <- pf(
      stat, 1, n - length(sela) - 1,
      lower.tail = FALSE, log.p = TRUE
    )
    
    ind[sela] <- 0
    r <- R[j, ]
    i <- 2
    
    while (rho[i] < logalpha & i < n) {
      i <- i + 1
      r[sela] <- 0
      
      r[ind] <- Rfast::eachcol.apply(
        x, res, indices = ind[ind > 0]
      )
      
      sel <- which.max(abs(r))
      sela <- c(sela, sel)
      sse1 <- sse2
      
      be <- try(
        solve(xx[sela, sela], xx[sela, j]),
        silent = TRUE
      )
      
      if (identical(class(be), "try-error")) {
        rho[i] <- 0
      } else {
        res <- y - x[, sela] %*% be
        sse2 <- sum(res^2)
        
        stat <- (sse1 - sse2) / sse2 *
          (n - length(sela) - 1)
        
        rho[i] <- pf(
          stat, 1, n - length(sela) - 1,
          lower.tail = FALSE, log.p = TRUE
        )
      }
      
      ind[sela] <- 0
    }
    
    len <- length(sela)
    Rho[[j]] <- rho[1:len]
    names(Rho[[j]]) <- c(0, sela[-len])
    G[j, sela[-len]] <- 1
  }
  
  list(G = G, Rho = Rho)
}


bench::mark(forward_loop_R(
  x = x,
  R = R,
  xx = xx,
  ini.sel = ini.sel,
  nama = nama,
  n = n,
  d = d,
  G = G,
  Rho = Rho,
  logalpha = logalpha
),
forward_loop_cpp(
  x = x,
  R = R,
  xx = xx,
  ini_sel = ini.sel,
  G = G,
  Rho = Rho,
  logalpha = logalpha
), iterations = 10
)
